{
  "name": "warren-sdk-ts",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Standalone TypeScript client SDK for the Warren VPN (workspace root).",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm --filter './packages/*' exec tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
