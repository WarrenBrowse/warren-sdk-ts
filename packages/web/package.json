{
  "name": "@warrenbrowse/sdk-web",
  "version": "0.0.0",
  "description": "Warren VPN TypeScript SDK: browser control-plane entry. Account state, checkout/voucher and verification, with no signing key in the page by default.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@warrenbrowse/sdk-core": "workspace:*"
  }
}
