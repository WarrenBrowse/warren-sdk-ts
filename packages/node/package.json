{
  "name": "@warrenbrowse/sdk-node",
  "version": "0.0.0",
  "description": "Warren VPN TypeScript SDK: Node datapath. ProxyTunnel (native napi proxy mode) + warrend system-VPN IPC client.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "native/warren-napi/index.cjs",
    "native/warren-napi/index.d.ts",
    "native/warren-napi/package.json",
    "native/warren-napi/*.node",
    "native/warren-napi/npm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "node ../../scripts/assert-engine-protocol.mjs"
  },
  "dependencies": {
    "@warrenbrowse/sdk-core": "workspace:*"
  }
}
