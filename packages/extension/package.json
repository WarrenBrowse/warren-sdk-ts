{
  "name": "@warrenbrowse/sdk-extension",
  "version": "0.0.0",
  "description": "Warren VPN TypeScript SDK: browser-extension VPN (chrome.proxy + native messaging) with its Node native host.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./host": {
      "import": {
        "types": "./dist/host/index.d.ts",
        "default": "./dist/host/index.js"
      },
      "require": {
        "types": "./dist/host/index.d.cts",
        "default": "./dist/host/index.cjs"
      }
    }
  },
  "files": ["dist", "src", "example", "scripts"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "build:example": "tsup --config tsup.example.config.ts"
  },
  "dependencies": {
    "@warrenbrowse/sdk-core": "workspace:*",
    "@warrenbrowse/sdk-node": "workspace:*"
  }
}
